# Reviewwo environment variables

# Required in production. Signs sign-in cookies. Generate with: openssl rand -hex 32
JWT_SECRET=

# Public URL of the site, read at runtime. Used in card links and QR codes.
# Set it before printing cards: changing it later breaks cards already printed.
APP_URL=https://reviewwo.divergit.com

# Canonical domain for SEO (canonical tags, sitemap, structured data). Read at build time.
SITE_URL=https://reviewwo.divergit.com
NEXT_PUBLIC_APP_URL=https://reviewwo.divergit.com

# Comma-separated emails that get the admin pages (coupons, NFC card requests, WhatsApp sender).
ADMIN_EMAILS=

# Optional: WhatsApp number that gets a message when a business requests NFC cards.
ORDER_ALERT_MOBILE=

# Where JSON data and the WhatsApp session are stored (a persistent disk in production).
# DATA_DIR=/var/data

# Razorpay keys for subscriptions. Without them, "Subscribe" shows a "payments not set up" message.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI review writing ("Use AI" on the customer review page, and owner replies).
# Set one key. Gemini is used when GEMINI_API_KEY is set, otherwise Claude.
# Without any key the button still works but fills in a simple sentence instead.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides.
# AI_PROVIDER=gemini            # or anthropic
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-latest
# AI_MODEL=claude-opus-5-5
# Max AI drafts per day across the whole server, and per QR code per hour.
# AI_DAILY_LIMIT=3000
# AI_PER_CODE_HOURLY=120
